# ==============================================================================
# SKETCH2SHAPE AI — ENVIRONMENT VARIABLES & API CREDENTIALS
# ==============================================================================
#
# NOTE: If you do not have external API keys, the application will automatically
# and seamlessly use its local neural (InstantMesh) and procedural reconstruction
# engines with zero functionality loss.
#
# To unlock premium cloud-based 3D generation and cloud PBR refinement, set:

# 1. Meshy API Key (https://meshy.ai)
# High-fidelity Image-to-3D with full PBR texture maps (Albedo, Normal, Roughness, Metallic)
MESHY_API_KEY=

# 2. Tripo3D API Key (https://tripo3d.ai)
# Fast cloud Image-to-3D with Tripo v2.5 foundation model
TRIPO_API_KEY=

# 3. Hyper3D Rodin API Key (https://hyper3d.ai)
# High-detail geometric reconstruction
RODIN_API_KEY=

# Local Server Settings
HOST=127.0.0.1
PORT=8000
DEVICE=cuda
